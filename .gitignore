# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
.pnpm-store/
*.log
.npm/

# TypeScript build output
dist/
*.tsbuildinfo
# wasm-pack output for anvil-codegen-wasm IS checked in: it's the actual
# distributable, built once per release on CI and committed so npm
# consumers don't need wasm-pack locally and so the workspace's
# anvil-unplugin can use it without a rebuild step.
!packages/anvil-codegen-wasm/dist/
!packages/anvil-codegen-wasm/dist/**

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test artifacts
coverage/
.nyc_output/
*.snap.new

# Generated code from anvil itself (in examples/fixtures)
*.anvil.ts.tmp

# Claude Code local session state
.claude/settings.local.json
