{
  "name": "express-app",
  "version": "0.0.1",
  "private": true,
  "description": "Express server with per-request DI scopes via anvil @Subcomponent factory parameters (M11).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "anvil:build": "cargo run --quiet -p anvil-cli --manifest-path ../../Cargo.toml -- build --entry src/app-component.ts",
    "anvil:check": "cargo run --quiet -p anvil-cli --manifest-path ../../Cargo.toml -- check --entry src/app-component.ts",
    "build": "pnpm anvil:build && tsc -p tsconfig.json",
    "typecheck": "pnpm anvil:build && tsc -p tsconfig.json --noEmit",
    "start": "pnpm anvil:build && tsx src/server.ts",
    "test": "pnpm anvil:build && vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "@msulak/anvil": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
