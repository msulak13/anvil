{
  "name": "todo-app",
  "version": "0.0.1",
  "private": true,
  "description": "Todo app: anvil DI + bellows controllers → OpenAPI → hey-api client → React + TanStack Query.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate:client": "tsx scripts/generate-client.ts",
    "generate": "vite build && pnpm generate:client",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "ANVIL_CLI_BIN=$PWD/../../target/debug/anvil ANVIL_BELLOWS_CLI_BIN=$PWD/../../target/debug/anvil-bellows ANVIL_BELLOWS_OPENAPI_CLI_BIN=$PWD/../../target/debug/anvil-bellows-openapi vite",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.app.json --noEmit",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:client",
    "build": "vite build"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.9.0",
    "@anvil-di/anvil": "workspace:*",
    "@anvil-di/bellows": "workspace:*",
    "@anvil-di/bellows-openapi": "workspace:*",
    "@anvil-di/anvil-unplugin": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
