{
  "name": "@anvil-di/anvil-cli-darwin-arm64",
  "version": "0.0.6",
  "description": "Prebuilt anvil CLI binary for darwin/arm64. Resolved by `@anvil-di/anvil-cli` at runtime.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "index.js",
  "files": [
    "bin/anvil",
    "index.js"
  ],
  "publishConfig": {
    "access": "public",
    "os": [
      "darwin"
    ],
    "cpu": [
      "arm64"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msulak13/anvil.git"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'bin','anvil'),0o755)}catch(e){}\"",
    "prepack": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'bin','anvil'),0o755)}catch(e){}\""
  }
}
