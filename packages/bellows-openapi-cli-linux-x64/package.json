{
  "name": "@anvil-di/bellows-openapi-cli-linux-x64",
  "version": "0.0.8",
  "description": "Prebuilt anvil-bellows-openapi CLI binary for linux/x64. Resolved by `@anvil-di/bellows-openapi-cli` at runtime.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "index.js",
  "files": [
    "bin/anvil-bellows-openapi",
    "index.js"
  ],
  "publishConfig": {
    "access": "public",
    "os": [
      "linux"
    ],
    "cpu": [
      "x64"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msulak13/anvil.git"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'bin','anvil-bellows-openapi'),0o755)}catch(e){}\"",
    "prepack": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'bin','anvil-bellows-openapi'),0o755)}catch(e){}\""
  }
}
